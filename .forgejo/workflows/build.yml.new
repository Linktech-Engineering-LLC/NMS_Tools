#
# Workflow: build.yml
# Workflow Class: Build
# Package: NMS_Tools
# Repository: Linux/NMS_Tools
#
# Author: Leon McClatchey
# Company: Linktech Engineering LLC
#
# Created: 2026-10-21
# Modified: 2026-10-21
# Version: 1.0.0
#
# Purpose:
#   Builds the packages and saves the artifacts to Linux/NMS_Tools/releases/nightly
#
# Triggers:
#   - workflow_dispatch
#
# Dependencies:
#   - none
#
# Artifacts Consumed:
#   - none
#
# Artifacts Produced:
#   - none
#
# Required Secrets:
#   - none
#
# Pipeline:
#
#   nightly-build
#          |
#          v
#      dashboard
#          |
#          v
#       publish
#
# Notes:
#   Additional implementation details


name: Forgejo Nightly Build
env:
  FORGEJO_URL: "http://dad:3000/api/v1/repos/linux/NMS_Tools/releases/tags/nightly"
  FORGEJO_BASE: "ssh://forgejo@dad:3001/Linux/NMS_Tools.git"
  FORGEJO_PAGES: "ssh://forgejo@dad:3001/doug/Pages.git"

on:
  schedule:
    - cron: "0 6 * * *"   # 06:00 UTC nightly
  workflow_dispatch:

concurrency:
  group: forgejo-nightly
  cancel-in-progress: true

jobs:

  nightly-build:
    runs-on: ubuntu-latest
    container:
      image: dad:3000/linux/leon-ci:latest
    env:
      FORGEJO_TOKEN: ${{ secrets.NMSTOOLSTOKEN }}
      FORGEJO_API: ${{ secrets.TOOLSAPITOKEN}}
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Ensure nightly tag exists
        run: |
          if ! git ls-remote --tags origin nightly >/dev/null; then
            echo "Creating nightly tag"
            git tag nightly
            git push origin nightly
          else
            echo "Updating nightly tag to current commit"
            git tag -f nightly
            git push origin nightly --force
          fi

      - name: Capture metadata
        id: capture
        run: |
          echo "build_date=$(date -u +"%Y-%m-%dT%H:%M:%SZ")" >> $GITHUB_OUTPUT
          echo "git_hash=$(git rev-parse HEAD)" >> $GITHUB_OUTPUT

      - name: Install Python 3.12
        run: |
          apt-get update
          apt-get install -y python3.12 python3.12-dev python3.12-venv

      - name: Install pandoc
        run: |
          apt-get update
          apt-get install -y pandoc
      - name: Create virtual environment
        run: |
          python3.12 -m venv /opt/venv
          source /opt/venv/bin/activate
          python -m pip install --upgrade pip

      - name: Install Python build dependencies
        run: |
          source /opt/venv/bin/activate
          pip install -r requirements.txt
          pip install pyinstaller jsonschema
          pip install git+http://dad:3000/linux/PythonTools.git

      - name: Make scripts executable
        run: |
          chmod +x scripts/*.sh
          chmod +x packaging/*.sh

      - name: Build all artifacts
        run: |
          source /opt/venv/bin/activate
          packaging/build_all.sh

      - name: Collect artifacts
        run: |
          curl -v -H "Authorization: token $FORGEJO_TOKEN" "$FORGEJO_URL"
          ls -al packaging/output
          mkdir -p artifacts
          cp packaging/output/*.tgz artifacts/ || true
          cp packaging/output/*.zip artifacts/ || true
          cp packaging/output/*.deb artifacts/ || true
          cp packaging/output/*.rpm artifacts/ || true
          ls -al artifacts
      # ============================================================
      # Ensure Forgejo nightly release exists (using GitHub metadata)
      # ============================================================

      - name: Ensure Forgejo nightly release exists
        id: forgejo_release
        run: |
          RELEASE=$(curl -s \
            -H "Authorization: token $FORGEJO_TOKEN" \
            "$FORGEJO_URL" \
            | jq -r '.id // empty')

          if [ -z "$RELEASE" ]; then
            echo "Creating Forgejo nightly release"
            curl -s -X POST \
              -H "Authorization: token $FORGEJO_TOKEN" \
              -H "Content-Type: application/json" \
              -d '{"tag_name":"nightly","name":"Nightly Build","body":"Nightly build artifacts","prerelease":true}' \
              http://dad:3000/api/v1/repos/linux/NMS_Tools/releases

            RELEASE=$(curl -s \
              -H "Authorization: token $FORGEJO_TOKEN" \
              "$FORGEJO_URL" \
              | jq -r '.id // empty')
          fi

          echo "forgejo_id=$RELEASE" >> $GITHUB_OUTPUT

      # ============================================================
      # Remove existing Forgejo nightly assets
      # ============================================================

      - name: Remove existing Forgejo nightly assets
        run: |
          RELEASE=${{ steps.forgejo_release.outputs.forgejo_id }}

          curl -s \
            -H "Authorization: token $FORGEJO_TOKEN" \
            "$FORGEJO_URL" \
            | jq -r '.assets[].id // empty' \
            | while read ID; do
                [ -z "$ID" ] && continue
                echo "Deleting Forgejo asset $ID"
                curl -s -X DELETE \
                  -H "Authorization: token $FORGEJO_TOKEN" \
                  "http://dad:3000/api/v1/repos/linux/NMS_Tools/releases/$RELEASE/assets/$ID"
              done

      # ============================================================
      # Upload Forgejo-built artifacts → Forgejo nightly release
      # ============================================================

      - name: Upload Forgejo-built artifacts to Forgejo release
        run: |
          RELEASE=${{ steps.forgejo_release.outputs.forgejo_id }}

          for f in artifacts/*.rpm \
                   artifacts/*.deb \
                   artifacts/*.tgz \
                   artifacts/*.zip; do
            [ -f "$f" ] || continue
            echo "Uploading $f"
            curl -s -X POST \
              -H "Authorization: token ${{ secrets.NMSTOOLSTOKEN }}" \
              -H "Content-Type: application/octet-stream" \
              --data-binary @"$f" \
              "http://dad:3000/api/v1/repos/linux/NMS_Tools/releases/$RELEASE/assets?name=$(basename "$f")"
          done


