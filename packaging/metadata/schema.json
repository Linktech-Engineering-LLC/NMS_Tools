{
  "type": "object",
  "required": ["meta_version", "build", "toolchain", "artifacts"],
  "properties": {
    "meta_version": {
      "type": "integer",
      "enum": [2]
    },
    "build": {
      "type": "object",
      "required": ["date", "commit", "version", "branch"],
      "properties": {
        "date": { "type": "string" },
        "commit": { "type": "string" },
        "version": { "type": "string" },
        "branch": { "type": "string" }
      }
    },
    "toolchain": {
      "type": "object",
      "required": ["python", "pyinstaller"],
      "properties": {
        "python": { "type": "string" },
        "pyinstaller": { "type": "string" }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "size", "sha256", "crc32", "type", "os", "arch"],
        "properties": {
          "name": { "type": "string" },
          "size": { "type": "integer" },
          "sha256": { "type": "string" },
          "crc32": { "type": "string" },
          "type": { "type": "string" },
          "os": { "type": "string" },
          "arch": { "type": "string" }
        }
      }
    }
  }
}
